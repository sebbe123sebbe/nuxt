# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys

# Public key (client-side) - Safe to expose in browser
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key (server-side) - Keep this secure!
NUXT_STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Optional: Webhook secret for webhook verification
NUXT_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase Configuration (if needed)
NUXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NUXT_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here